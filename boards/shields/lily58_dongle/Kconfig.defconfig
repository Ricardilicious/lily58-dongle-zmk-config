if SHIELD_LILY58_DONGLE

config ZMK_KEYBOARD_NAME
    default "Lily58"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Two peripherals: left half + right half
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 5 host profiles + 2 halves
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

# ---- OLED (same display defaults ZMK's own lily58 shield uses) ----
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

# The OLED is 1-bit monochrome. Without these, LVGL renders in 16/32-bit
# colour, never draws to the screen, and the OLED just shows random static.
config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

endif # LVGL

endif
